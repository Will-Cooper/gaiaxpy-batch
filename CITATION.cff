    given-names: "W. J."
    orcid: "https://orcid.org/0000-0003-3501-8967"
    affiliation: "University of Hertfordshire, Centre for Astrophysics Research"
version: "2.0.1"
date-released: "2026-10-23"
license: BSD-3-Clause
repository-code: "https://github.com/Will-Cooper/gaiaxpy-batch"
url: "https://github.com/Will-Cooper/gaiaxpy-batch"
keywords:
  - Gaia
  - Gaia DR3
  - XP spectra
  - BP/RP spectra
  - GaiaXPy
  - astronomy
  - spectroscopy
